  </appSettings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.35.35.253\private$\entlib" filePath="~\Logs\Logs.txt" defaultCategory="NAP-Activity-Tracking" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
