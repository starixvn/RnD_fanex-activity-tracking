<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>

  <appSettings>
    <add key="ElasticsearchUriList" value="https://10.18.200.109:9206/"/>
    <add key="ElasticsearchAuthInfo" value="admin:1q2w3e4r" />
    <add key="ElasticsearchIndex" value="activity_tracking_local"/>
