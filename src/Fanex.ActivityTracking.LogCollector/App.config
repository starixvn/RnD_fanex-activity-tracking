<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>

  <appSettings>
    <add key="ElasticsearchUriList" value="http://10.18.200.109:9202/" />
    <add key="ElasticsearchAuthInfo" value="admin:Ilu@n3xc3l" />
    <add key="ElasticsearchIndex" value="tracking_activity_local" />
    <add key="ActivityTracking:ConfigFilePath" value="App_Data\activitytracking.json" />
    <add key="SubscriptionId" value="Fanex.ActivityTracking.LogCollector.Ext" />
  </appSettings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.18.200.103\private$\entlib" defaultCategory="Activity-Tracking" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
