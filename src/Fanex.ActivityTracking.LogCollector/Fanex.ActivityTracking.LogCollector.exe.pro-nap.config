<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>

  <appSettings>
    <add key="ElasticsearchUriList" value="http://10.40.40.135:9202/" />
    <add key="ElasticsearchIndex" value="activity_tracking_pro" />
    <add key="ActivityTracking:ConfigFilePath" value="App_Data\activitytracking.json" />
    <add key="ElasticsearchAuthInfo" value="logstash2:logstash2Ea" />
    <add key="SubscriptionId" value="Fanex.ActivityTracking.LogCollector.Nap"/>
  </appSettings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.22\private$\entlib" filePath="~\Logs\Logs.txt" defaultCategory="Activity-Tracking" />
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.0" newVersion="10.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
